# App
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/assistant?schema=public"
APP_URL="http://localhost:3000"
# Generate a unique secret with: openssl rand -base64 48
AUTH_SECRET="replace-this-with-a-unique-random-secret-at-least-32-characters"

# Google Cloud Console OAuth 2.0 web client
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# LLM provider (not wired to live chat yet)
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL=""

# Optional background jobs
REDIS_URL=""

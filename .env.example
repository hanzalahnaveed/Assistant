# App
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/assistant?schema=public"
# Public app origin; set this to the deployed HTTPS origin in production.
APP_URL="http://localhost:3000"
# Generate a unique secret with: openssl rand -base64 48
AUTH_SECRET="replace-this-with-a-unique-random-secret-at-least-32-characters"

# Optional Google Cloud OAuth 2.0 web client for Google sign-in and Workspace integration.
# Add GOOGLE_REDIRECT_URI exactly as shown here to Authorized redirect URIs.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Use dummy mode to avoid API usage. Set classifier mode to "groq" for live Groq classification.
EMAIL_AGENT_CLASSIFIER_MODE="dummy"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Scheduled workers: generate with openssl rand -base64 48.
# Use a different secret from AUTH_SECRET.
CRON_SECRET=""
# GitHub Actions also needs repository variable APP_BASE_URL (deployed app origin)
# and repository secret CRON_SECRET (same value as this app environment variable).

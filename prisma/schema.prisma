generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IntegrationProvider {
  GOOGLE
}

enum ActionStatus {
  PENDING
  APPROVED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ApprovalMode {
  AUTO
  CONFIRM
  BLOCK
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  name         String?
  imageUrl     String?
  timezone     String        @default("Asia/Karachi")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  preferences  UserPreference?
  integrations Integration[]
  tasks        Task[]
  conversations Conversation[]
  automationRules AutomationRule[]
  actions      ActionRecord[]
  auditEvents  AuditEvent[]
  dailyBriefings DailyBriefing[]
  notifications Notification[]
}

model UserPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  dailyBriefingEnabled  Boolean  @default(true)
  briefingHour          Int      @default(8)
  defaultApprovalMode   ApprovalMode @default(CONFIRM)
  preferencesJson       Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Integration {
  id                String              @id @default(cuid())
  userId            String
  provider          IntegrationProvider
  providerAccountId String?
  email             String?
  accessTokenEnc    String?
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  scopes            String[]            @default([])
  lastSyncedAt      DateTime?
  syncCursor        String?
  status            String              @default("CONNECTED")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, providerAccountId])
  @@index([userId, provider])
}

model Task {
  id           String       @id @default(cuid())
  userId       String
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueAt        DateTime?
  source       String       @default("USER")
  sourceRef    String?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
  @@index([userId, createdAt])
  @@unique([userId, source, sourceRef])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String       @db.Text
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AutomationRule {
  id          String       @id @default(cuid())
  userId      String
  name        String
  actionType  String
  mode        ApprovalMode @default(CONFIRM)
  enabled     Boolean      @default(true)
  conditions  Json         @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

model ActionRecord {
  id             String       @id @default(cuid())
  userId         String
  actionType     String
  status         ActionStatus @default(PENDING)
  idempotencyKey String
  input          Json         @default("{}")
  result         Json         @default("{}")
  requiresApproval Boolean    @default(true)
  approvedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  errorCode      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String
  eventType  String
  actor      String   @default("SYSTEM")
  resourceId String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}


model DailyBriefing {
  id          String   @id @default(cuid())
  userId      String
  localDate   String
  timezone    String
  summary     String   @db.Text
  content     Json     @default("{}")
  generatedAt DateTime @default(now())
  readAt      DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@index([userId, generatedAt])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  idempotencyKey String
  type           String
  title          String
  body           String   @db.Text
  payload        Json     @default("{}")
  readAt         DateTime?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, readAt, createdAt])
}
